{
  "name": "wipeout-map",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "tsx scripts/verify/run.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @wipeout/server dev\" \"pnpm --filter @wipeout/web dev\"",
    "build": "pnpm --filter @wipeout/web build && pnpm --filter @wipeout/server build",
    "start": "pnpm --filter @wipeout/server start",
    "record-fixtures": "tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.32.1",
    "dotenv": "^17.2.1",
    "viem": "^2.37.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
